# SWARM PROTOCOL: SURVIVOR - Production Environment
# This file contains production environment variables
# DO NOT commit this file to version control with actual values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Application Configuration
VITE_APP_NAME=Swarm Protocol: Survivor
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production
VITE_APP_DEBUG=false

# API Configuration
VITE_API_BASE_URL=https://your-api-domain.com

# Analytics (Optional)
VITE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_ANALYTICS_ENABLED=true

# Sentry Error Tracking (Optional)
VITE_SENTRY_DSN=https://xxxxxxxxx@o0.ingest.sentry.io/0
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT=production

# Feature Flags
VITE_FEATURE_AUDIO_ENABLED=true
VITE_FEATURE_ANALYTICS_ENABLED=true
VITE_FEATURE_LEADERBOARDS_ENABLED=true
VITE_FEATURE_SOCIAL_SHARE_ENABLED=true

# Game Configuration
VITE_DEFAULT_HERO_ID=hero_01
VITE_MAX_PLAYERS=1
VITE_DEFAULT_DIFFICULTY=normal

# Build Configuration
VITE_BUILD_DATE=${BUILD_DATE}
VITE_BUILD_HASH=${BUILD_HASH}

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_XSS_PROTECTION=true

# Performance
VITE_ENABLE_CACHE=true
VITE_CACHE_TTL=3600
